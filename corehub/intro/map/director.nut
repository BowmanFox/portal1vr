        e.SetOrigin((p)+Vector(-13000,0,0));e.__KeyValueFromString("angles",ang.x+" "+ang.y+" "+ang.z);
        if(fill!=null)fill.SetOrigin((p+Vector(10,-10,-33))+Vector(-13000,0,0));return;
      }
    }
    local cubeZ=P41_Lerp1(P41_earlyCubeZ,t);
    e.SetOrigin((P41_TransformRig(Vector(0,-256,cubeZ)))+Vector(-13000,0,0));
    if(fill!=null)fill.SetOrigin((P41_TransformRig(Vector(16,-272,cubeZ-52)))+Vector(-13000,0,0));
    e.__KeyValueFromString("angles",P41_Lerp1(P41_earlyCubePitch,t)+" "+(P41_Lerp1(P41_earlyCubeYaw,t)+90)+" "+(-450*(t-30.93)));
