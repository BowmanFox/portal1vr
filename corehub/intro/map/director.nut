PODX <- 11491.50; PODY <- 28.0; PODZ <- 131.0; XHW <- 11296.0;
function Lerp1(tab,t) {
    if(t<=tab[0][0])return tab[0][1];
    for(local i=0;i<tab.len()-1;i++){
        if(t<tab[i+1][0]){local a=tab[i],b=tab[i+1];return a[1]+(b[1]-a[1])*(t-a[0])/(b[0]-a[0]);}
    }
    return tab[tab.len()-1][1];
}
