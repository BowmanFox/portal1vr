function P41_MoveEarly(name,p){local e=Entities.FindByName(null,name);if(e!=null){local q=Vector(162.2,-132.3,127.3)+(p-Vector(162.2,-132.3,127.3))*1.5170630816959667;if(name=="p41_intro_ceiling_wire")q+=Vector(57.48747547,-54.12638387,-9.24376903);if(name=="p41_intro_ceiling_chip_0")q+=Vector(38.25808012,-42.56427126,-0.01468459);if(name=="p41_intro_ceiling_chip_1")q+=Vector(38.74625753,-31.00226695,-0.04881075);if(name=="p41_intro_ceiling_chip_2")q+=Vector(35.45759532,-31.10250649,-0.04881075);if(q.z<4)q.z=4;e.SetOrigin((q)+Vector(-13000,0,0));}}
function P41_SetOpeningDebris(t) {
    local starts=[Vector(127.864,-160.735,219),Vector(162.494,-91.175,221),Vector(149.355,-91.488,221)];
    local velocities=[300.0,180.0,110.0];
    local gravities=[1400.0,700.0,500.0];
    local restZ=[3.124,1.7329,1.957];
    local elapsed=t-6.8;if(elapsed<0)elapsed=0;
    for(local i=0;i<3;i++) {
        local fall=velocities[i]*elapsed+0.5*gravities[i]*elapsed*elapsed;
        if(fall>starts[i].z-restZ[i])fall=starts[i].z-restZ[i];
        P41_MoveEarly("p41_intro_ceiling_chip_"+i,starts[i]-Vector(0,0,fall));
    }
    local f=(t-6.8)/0.35;if(f<0)f=0;if(f>1)f=1;
    f=f*f*(3-2*f);
    P41_MoveEarly("p41_intro_ceiling_wire",Vector(154.862409,-142.150324,174.327556-(174.327556-1.658499)*f));
    local wire=Entities.FindByName(null,"p41_intro_ceiling_wire");
    if(wire!=null)wire.__KeyValueFromString("angles","0 0 "+(90*f));
}


