    MoveProp("intro_pod_shell",(t>=125.3)?Vector(0,0,16)+eye-Vector(XHW+160,0,134):Vector(0,0,-3000));
    local radio=Entities.FindByName(null,"intro_delivery_radio");
    if(radio!=null){
        if(t<124.55 || t>125.8)radio.SetOrigin(Vector(PODX,0,-2600));
        else{
            local keys=[
    {t=124.55000,p=Vector(10617.22676,24.91338,103.39404),a=Vector(4,-44,37)},
    {t=124.75000,p=Vector(11025.96049,-6.21604,108.07476),a=Vector(4,-38,40)},
    {t=125.00000,p=Vector(11285.81675,11.57472,111.85833),a=Vector(4,-31,43)},
    {t=125.10000,p=Vector(11369.71829,18.75351,113.5065),a=Vector(4,-25,40)},
    {t=125.15000,p=Vector(11397.82825,21.38072,113.43348),a=Vector(3,-18,34)},
    {t=125.25000,p=Vector(11383.62761,20.95145,116.82675),a=Vector(-45,-25,60)},
    {t=125.35000,p=Vector(11336.15893,-0.11387,117.13656),a=Vector(-30,-20,83)},
    {t=125.45000,p=Vector(11344.71265,3.56164,116.3775),a=Vector(-12,-10,95)},
    {t=125.60000,p=Vector(11325.61608,-14.70446,116.77634),a=Vector(35,5,108)},
    {t=125.80000,p=Vector(11340.0,-60.0,116.0),a=Vector(70,10,120)}
            ];
            local k=0;while(k<keys.len()-2 && t>keys[k+1].t)k++;
            local f=(t-keys[k].t)/(keys[k+1].t-keys[k].t);if(f<0)f=0;if(f>1)f=1;
            local p=keys[k].p+(keys[k+1].p-keys[k].p)*f;
