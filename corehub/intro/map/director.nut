function Wake46At(t,angle=false){
 local i=(t*120).tointeger();if(i<0)i=0;if(i>wake46Keys.len()-2)i=wake46Keys.len()-2;
 local a=wake46Keys[i],b=wake46Keys[i+1],f=(t-a.t)/(b.t-a.t);if(f<0)f=0;if(f>1)f=1;
 return angle?a.a+(b.a-a.a)*f:a.p+(b.p-a.p)*f;
}

function PositionAt(t) {
    if(t<21.7)return Wake46At(t);
    if(t>=96.596307 && t<99.7995006)return Factory43At(t);

    local i=0;
    while(i<positions.len()-2 && t>=positions[i+1].t)i++;
    local a=positions[i], b=positions[i+1];
    local f=(t-a.t)/(b.t-a.t); if(f<0)f=0; if(f>1)f=1;
    // Hold the eye across scene changes until the corresponding black transition.
    // Stay at the last outlet pose until the exact first black frame.
    if((a.t>=32.5 && a.t<32.51) || (a.t>=38.9388 && a.t<39.10) || (a.t>=118.3512 && a.t<118.3847)) f=0.0;
    return a.p+(b.p-a.p)*f;
}
function MoveProp(name,p) {local e=Entities.FindByName(null,name);if(e!=null)e.SetOrigin(p);}
