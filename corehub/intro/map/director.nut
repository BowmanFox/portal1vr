turretLaserKeys <- [
 {t=67.2,p=Vector(4646,-3,1130)},
 {t=67.5,p=Vector(4646,-3,1130)},
 {t=67.75,p=Vector(4605,15,1085)},
 {t=68.0,p=Vector(4562,52,1069)},
