function SetScreenBlack(alpha) {
    alpha=alpha.tointeger();if(alpha<0)alpha=0;if(alpha>255)alpha=255;
    if(alpha==screenBlackAlpha)return;
    local fade=Entities.FindByName(null,"intro_reference_fade");
    if(fade==null){printl("COREHUB_FADE_MISSING");return;}
    fade.__KeyValueFromString("renderamt",""+alpha);
    EntFire("intro_reference_fade","Fade","",0);
    screenBlackAlpha=alpha;
}
// Physical debris fall measured from source6.8068-7.5075, deterministic for QA seeks.
function SetOpeningDebris(t) {
    local starts=[Vector(127.864,-160.735,219),Vector(162.494,-91.175,221),Vector(149.355,-91.488,221)];
    local velocities=[300.0,180.0,110.0];
    local gravities=[1400.0,700.0,500.0];
    local restZ=[3.124,1.7329,1.957];
    local elapsed=t-6.8;if(elapsed<0)elapsed=0;
    for(local i=0;i<3;i++) {
        local fall=velocities[i]*elapsed+0.5*gravities[i]*elapsed*elapsed;
        if(fall>starts[i].z-restZ[i])fall=starts[i].z-restZ[i];
        MoveProp("intro_ceiling_chip_"+i,starts[i]-Vector(0,0,fall));
    }
    local f=(t-6.8)/0.35;if(f<0)f=0;if(f>1)f=1;
    f=f*f*(3-2*f);
    MoveProp("intro_ceiling_wire",Vector(154.862409,-142.150324,174.327556-(174.327556-1.658499)*f));
    local wire=Entities.FindByName(null,"intro_ceiling_wire");
    if(wire!=null)wire.__KeyValueFromString("angles","0 0 "+(90*f));
}
earlyCubeZ <- [[30.52, 13.1932], [30.55, 104.3628], [30.6, 132.8253], [30.65, 240.0945], [30.7, 360.5527], [30.75, 429.5278], [30.8, 596.1209], [30.85, 637.2816], [30.9, 721.6672], [30.95, 836.12], [31, 836.6858], [31.25, 1350.865], [31.5, 2111.604], [31.75, 2281.263], [32, 2322.8], [32.25, 2585.775]];
earlyCubePitch <- [[30.52, 0], [30.55, 0.0], [30.6, 4.35], [30.65, 7.833], [30.7, 9.757], [30.75, 9.738], [30.8, 7.781], [30.85, 4.274], [30.9, -0.084], [30.95, -4.425], [31, -7.885], [31.25, 0.168], [31.5, 7.674], [31.75, -9.809], [32, 4.65], [32.25, 3.967]];
earlyCubeYaw <- [[30.52, 0], [30.55, 0], [30.6, 15], [30.65, 30], [30.7, 0], [30.75, 15], [30.8, 30], [30.85, 45], [30.9, 30], [30.95, 15], [31, 0], [31.25, 0], [31.5, 15], [31.75, 20], [32, 30], [32.25, 30]];
function SetEarlyShaftCube(t) {
    local e=Entities.FindByName(null,"intro_early_cube");if(e==null)return;
    local fill=Entities.FindByName(null,"intro_early_cube_fill");
    if(t<30.52 || t>=32.4990684){
        e.SetOrigin(Vector(0,0,-3000));
        if(fill!=null)fill.SetOrigin(Vector(0,0,-3000));
        return;
    }
    local cubeZ=Lerp1(earlyCubeZ,t);
    e.SetOrigin(Vector(0,-256,cubeZ));
    if(fill!=null)fill.SetOrigin(Vector(16,-272,cubeZ-52));
    e.__KeyValueFromString("angles",Lerp1(earlyCubePitch,t)+" "+Lerp1(earlyCubeYaw,t)+" 0");
}
P41_previewPlayer <- null; P41_previewCamera <- null; P41_irisCeilingLit <- null;
function P41_TransformRig(p){return Vector(105.02214548537-(p.y+256)*0.63,-46.078397476069995+(p.x-1.65015983)*0.63,274+(p.z-224)*0.63);}
function P41_MoveProp(name,p){local e=Entities.FindByName(null,name);if(e!=null)e.SetOrigin((P41_TransformRig(p))+Vector(-13000,0,0));}
function P41_Lerp1(tab,t) {
    if(t<=tab[0][0])return tab[0][1];
    for(local i=0;i<tab.len()-1;i++){
        if(t<tab[i+1][0]){local a=tab[i],b=tab[i+1];return a[1]+(b[1]-a[1])*(t-a[0])/(b[0]-a[0]);}
    }
    return tab[tab.len()-1][1];
}
function P41_SetIntroIris(t) {
    // 22-22.75 s: the closed disc sits retracted in its trap door (z 262).
    // 22.75-23 s: it comes down flush with the ceiling (its face 1.5 below the
    // tiles, so the spreading petals slide over them as in the video), the
    // petals spread, and the frame settles at the top of the shaft (z 262).
    // 31-31.6 s: retract as the camera actually crosses into the tube.
    local d=(t-22.75)/0.25; if(d<0)d=0; if(d>1)d=1; d=d*d*(3-2*d);
    d=P41_Lerp1([[22.5,0],[22.6,0.23],[22.65,0.3089482],[22.7,0.343596],[22.75,0.4085875],[22.8,0.4423864],[22.85,0.5135333],[22.9,0.5604078],[22.95,0.6125715],[23.0,0.6343375],[23.1,0.7102489],[23.2,0.7860345],[23.3,0.95118],[23.4,1.0]],t);
    local s=(t-22.9)/0.6; if(s<0)s=0; if(s>1)s=1; s=s*s*(3-2*s);
    local r=0;
    local fz=(t<22.8)?420:(420-214.89262324*d)+214.89262324*r;
    P41_MoveProp("p41_intro_iris_frame",Vector(1.65015983,-256,fz));
    local lit=false;
    if(lit!=P41_irisCeilingLit){
        P41_irisCeilingLit=lit;
        EntFire("p41_intro_iris_ceiling_fill",lit?"TurnOn":"TurnOff","",0);
    }
    P41_MoveProp("p41_intro_iris_rings",Vector(1.65015983,0,16+fz-205.10737676));
    for(local i=0;i<4;i++){
        local a=(i*90+45)*0.0174532925;
        local k=P41_Lerp1([[22.9, 0], [23.0, 4.0], [23.1, 12.0046], [23.2, 22.5336], [23.3, 33.3051], [23.4, 41.4304], [23.5, 46.3554], [23.6, 48.0918], [23.7, 48.1355], [23.8, 48.1355], [23.9, 48.1443], [24.0, 48.27]],t)+50*r;
        local spread=(t-22.9)/0.6;if(spread<0)spread=0;if(spread>1)spread=1;spread=spread*spread*(3-2*spread);
        local settle=P41_Lerp1([[23.7,0],[25.9925814,0],[29.9965734,1]],t);
        local fitK=43.455869413+(42.089394470-43.455869413)*settle;
        local fitZ=169.651085638+(159.355693830-169.651085638)*settle;
        local fitX=-0.710794644+(-0.934976097-(-0.710794644))*settle;
        local fitY=0.164647461+(0.656211556-0.164647461)*settle;
        k=k*(1+(fitK/48.27-1)*spread);
        P41_MoveProp("p41_intro_iris_"+i,Vector(1.65015983+(fitY/0.63)*spread,-256-(fitX/0.63)*spread,253)+Vector(-k*sin(a),k*cos(a),-65.39262324*d*(1-r)+60*r+(fitZ-187.60737676)*spread));
    }
}
