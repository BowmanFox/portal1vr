        return;
    }
    if(t<=30.93){
      for(local i=0;i<P41_cubeMotionKeys.len()-1;i++){
        local a=P41_cubeMotionKeys[i],b=P41_cubeMotionKeys[i+1];if(t>b.t)continue;
