player <- null;
started <- false;
startTime <- 0.0;
finished <- false;
lastReport <- -1;
eyeSample <- null;
viewCamera <- null;
qaMouseLock <- false;
currentFov <- 0;
function FilmFov(t) { if(t>=96.596307 && t<99.7995006)return 59; if(t<=22)return 60.0;if(t<22.2)return 60-(t-22)*25;return (t<32.51 || t>=118.3847)?55:90; }
function ApplyFov(t) {
    local want=FilmFov(t);
    if(want==currentFov)return;
    currentFov=want;
    if(want!=90)Entities.FindByName(null,"intro_zoom").__KeyValueFromString("FOV",""+want);
    local p=Entities.FindByClassname(null,"player");
    EntFire(want==90?"intro_zoom":"intro_zoom90","UnZoom","",0,p);
    EntFire(want==90?"intro_zoom90":"intro_zoom","Zoom","",0.02,p);
}
qaReferenceOpening <- false;
openingWalking <- false;
rideTakeover <- false;
rideInputBase <- Vector(0,0,0);
rideLookBase <- Vector(0,0,0);
pullStartEye <- Vector(0,0,0);
function WrapDelta(x){while(x>180)x-=360;while(x< -180)x+=360;return x;}
function EaseWalk(f){if(f<0)return 0.0;if(f>1)return 1.0;return f*f*f*(10.0-15.0*f+6.0*f*f);}
function MeasuredLook(){local dir=eyeSample.GetForwardVector();return Vector(asin(-dir.z)*57.2957795,atan2(dir.y,dir.x)*57.2957795,0);}
function Start() {
 player=Entities.FindByClassname(null,"player");
 if(player==null){EntFire("intro_director","CallScriptFunction","Start",0.1);return;}
 startTime=Time();started=true;finished=false;lastReport=-1;
 player.__KeyValueFromString("targetname","intro_player");
 player.__KeyValueFromString("rendermode","10");player.__KeyValueFromString("renderamt","0");
 eyeSample=Entities.FindByName(null,"intro_eye_sample");viewCamera=Entities.FindByName(null,"intro_camera");
 EntFire("intro_eye_measure","SetMeasureTarget","intro_player",0);
 openingWalking=!qaReferenceOpening;rideTakeover=false;
 if(openingWalking){
  player.SetOrigin(Vector(-12825.165721,-191.103732,0.1));player.SetVelocity(Vector(0,0,0));
  player.__KeyValueFromString("gravity","1");
  // Camera starts disabled; do not send Disable before its first Enable.
  EntFire("intro_input_lock","ModifySpeed","1",0,player);
  EntFire("intro_client","Command","-left;-right;-lookup;-lookdown",0,player);
  EntFire("intro_walk_spawn","Teleport","",0,player);
 }else{
  player.__KeyValueFromString("gravity","0");
  EntFire("intro_input_lock","ModifySpeed","0",0,player);
  EntFire("intro_client","Command","-left;-right;-lookup;-lookdown",0,player);
  EntFire("intro_reference_spawn","Teleport","",0,player);
  EntFire("intro_camera","Enable","",0.05,player);
 }
 EntFire("intro_client","Command","hidehud 4;r_aspectratio 1.6;"+(qaMouseLock?"cl_mouseenable 0":"cl_mouseenable 1"),0,player);
 EntFire("intro_soundtrack","PlaySound","",0);
 printl("COREHUB_INTRO START duration=134 freelook=1 walkingOpening="+openingWalking+" worldtime="+Time());
 Tick();
}
function BeginSuction(t){
 openingWalking=false;rideTakeover=true;
 pullStartEye=eyeSample.GetOrigin();rideInputBase=MeasuredLook();rideLookBase=rideInputBase;
 player.__KeyValueFromString("gravity","0");
 EntFire("intro_input_lock","ModifySpeed","0",0,player);
 EntFire("intro_client","Command","-forward;-back;-moveleft;-moveright;-jump;-duck",0,player);
 EntFire("intro_camera","Enable","",0,player);
 printl("COREHUB_SUCTION_HANDOFF time="+t+" eye="+pullStartEye+" input="+rideInputBase);
}

