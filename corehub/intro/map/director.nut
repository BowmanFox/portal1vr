shaftBeamState <- -1;
turretBeamState <- -1;
function SetTransportBeams(t) {
    local n=0;
    while(n<turretLaserKeys.len()-2 && t>=turretLaserKeys[n+1].t)n++;
    local a=turretLaserKeys[n],b=turretLaserKeys[n+1];
    local f=(t-a.t)/(b.t-a.t);if(f<0)f=0;if(f>1)f=1;
    // This2009 runtime interprets SetOrigin on a child in parent-local space.
    // The keyed aim points remain in world space; inverse-transform by the
    // static turret parent at(4575,58,1159), yaw-114.
    local worldEnd=a.p+(b.p-a.p)*f;
    local rel=worldEnd-Vector(4575,58,1159);
    local localEnd=Vector(-0.4067366431*rel.x-0.9135454576*rel.y,
                          0.9135454576*rel.x-0.4067366431*rel.y,rel.z);
    MoveProp("laser_turret_b",localEnd);
    local turretOn=(t>=67.2 && t<69.4)?1:0;
    if(turretOn!=turretBeamState) {
        EntFire("laser_turret",turretOn==1?"TurnOn":"TurnOff","",0);
        turretBeamState=turretOn;
    }
    // Exact79.5 still has red projection; by80.0 it has cleared the yellow scan.
    // Names are supplied by the shared scanner_arms beam-naming correction.
    local shaftOn=(t>=72.25 && t<79.6)?1:0;
    if(shaftOn!=shaftBeamState) {
        foreach(z in [1200,760,620])for(local i=0;i<3;i++)
            EntFire("shaft_"+z+"_"+i+"_beam",shaftOn==1?"TurnOn":"TurnOff","",0);
        shaftBeamState=shaftOn;
    }
}
function SetTransferScanners(t) {
    local n=0;
    while(n<transferScanPoses.len()-2 && t>=transferScanPoses[n+1].t)n++;
    local a=transferScanPoses[n],b=transferScanPoses[n+1];
    local f=(t-a.t)/(b.t-a.t);if(f<0)f=0;if(f>1)f=1;
    local labels=["upper","fore","head"];
    for(local i=0;i<6;i++) {
        local pa=a.parts[i],pb=b.parts[i];
        local pos=pa.p+(pb.p-pa.p)*f,angle=pa.a+(pb.a-pa.a)*f;
        local arm=i/3,part=i%3;
        local e=Entities.FindByName(null,"intro_transfer_scan_"+labels[part]+"_"+arm);
        if(e!=null){e.SetOrigin(pos);e.__KeyValueFromString("angles",angle.x+" "+angle.y+" "+angle.z);}
        if(part==2) {
            local cone=Entities.FindByName(null,"intro_transfer_scan_cone_"+arm);
            local visible=(arm==0)?(t>=78.4 && t<80.2):(t>=80.15 && t<82.45);
            if(cone!=null){cone.SetOrigin(visible?pos:Vector(0,0,-3000));cone.__KeyValueFromString("angles",angle.x+" "+angle.y+" "+angle.z);}
        }
    }
}
function SetFinalScanners(t) {
    local n=0;
    while(n<finalScanPoses.len()-2 && t>=finalScanPoses[n+1].t)n++;
    local a=finalScanPoses[n],b=finalScanPoses[n+1];
    local f=(t-a.t)/(b.t-a.t);if(f<0)f=0;if(f>1)f=1;
    local labels=["upper","fore","head"];
    for(local i=0;i<9;i++){
        local pa=a.parts[i],pb=b.parts[i];
        local pos=pa.p+(pb.p-pa.p)*f,angle=pa.a+(pb.a-pa.a)*f;
        local arm=i/3,part=i%3;
        local e=Entities.FindByName(null,"intro_final_scan_"+labels[part]+"_"+arm);
        if(e!=null){e.SetOrigin(pos);e.__KeyValueFromString("angles",angle.x+" "+angle.y+" "+angle.z);}
        if(part==0)MoveProp("intro_final_scan_mount_"+arm,pos);
        if(part==2){
            local cone=Entities.FindByName(null,"intro_final_scan_cone_"+arm);
            if(cone!=null){cone.SetOrigin((t>=116.65&&t<117.42)?pos:Vector(0,0,-3000));cone.__KeyValueFromString("angles",angle.x+" "+angle.y+" "+angle.z);}
            local longcone=Entities.FindByName(null,"intro_final_scan_long_cone_"+arm);
            if(longcone!=null){longcone.SetOrigin((t>=115.32&&t<116.65)?pos:Vector(0,0,-3000));longcone.__KeyValueFromString("angles",angle.x+" "+angle.y+" "+angle.z);}
        }
    }
}
function ReferenceAngles(t) {
    if(t<21.7)return Wake46At(t,true);
    if(t>=96.596307 && t<99.7995006)return Factory43At(t,true);

    local i=0;
    while(i<knots.len()-2 && t>=knots[i+1].t)i++;
    local a=knots[i],b=knots[i+1],f=(t-a.t)/(b.t-a.t);
    if(f<0)f=0;if(f>1)f=1;
    return a.a+(b.a-a.a)*f;
}
function AddReferencePan(t) {
 if(eyeSample==null || viewCamera==null)return;
 local reference=ReferenceAngles(t),observed=MeasuredLook();local desired=reference+observed;
 if(rideTakeover){
  local f=EaseWalk((t-21.7)/1.6);
  local input=Vector(WrapDelta(observed.x-rideInputBase.x),WrapDelta(observed.y-rideInputBase.y),0);
  local delta=Vector(WrapDelta(reference.x-rideLookBase.x),WrapDelta(reference.y-rideLookBase.y),reference.z);
  desired=rideLookBase+delta*f+input;
 }
 if(desired.x>180)desired.x=180;if(desired.x< -180)desired.x=-180;
 viewCamera.__KeyValueFromString("angles",desired.x+" "+desired.y+" "+desired.z);
}
function Tick() {
 if(!started || player==null)return;
 local t=Time()-startTime;local bounded=t>134?134:t;local p=player.GetOrigin()+Vector(0,0,64);
 if(openingWalking && t>=21.7)BeginSuction(t);
 if(!openingWalking){
  AddReferencePan(bounded);p=PositionAt(bounded);
  if(rideTakeover && t<23.3)p=pullStartEye+(p-pullStartEye)*EaseWalk((t-21.7)/1.6);
  if(viewCamera!=null)viewCamera.SetOrigin(p);
  player.SetOrigin(p-Vector(0,0,64));player.SetVelocity(Vector(0,0,0));
 }
 SetSceneTime(t);
 local report=t.tointeger()/10;
 if(!finished && report!=lastReport){lastReport=report;printl("COREHUB_INTRO T="+t+" POSITION="+p+" walking="+openingWalking);}
 if(t>=134 && !finished){finished=true;printl("COREHUB_INTRO COMPLETE duration="+t);}
 EntFire("intro_director","CallScriptFunction","Tick",0.015);
}
