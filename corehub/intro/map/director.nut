function Factory43At(t,angle=false) {
    local i=0;while(i<factory43Keys.len()-2 && t>=factory43Keys[i+1].t)i++;
    local a=factory43Keys[i],b=factory43Keys[i+1],f=(t-a.t)/(b.t-a.t);
