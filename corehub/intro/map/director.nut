function Hide(name,show,rest) { MoveProp(name,show?rest:Vector(0,0,-3000)); }
function SetEnding(t) {
    local rest=Vector(0,0,16);
    local g=Lerp1(petalTab,t);
    local bright=(t>=125.2);
    for(local i=0;i<4;i++){
        local su=(i==0||i==3)?1:-1; local sv=(i<2)?1:-1;
        local off=Vector(0,su*g,16+sv*g);
        MoveProp("intro_final_petal_"+i,bright?Vector(0,0,-3000):off);
        MoveProp("intro_final_petalb_"+i,bright?off:Vector(0,0,-3000));
    }
    MoveProp("intro_final_shutter",Vector(0,0,16+Lerp1(shutterTab,t)));
    Hide("intro_final_redmod",t>=125.2 && t<126.35,rest);
    // The cover and fracture share the body's delivery motion. Leaving them
    // at their old world position made the later camera pass through the pane.
    local capsuleRest=Vector(PODX,PODY,PODZ);
    local capsuleEye=PositionAt(t);
    local capsuleBlend=(t-124.6)/0.8;if(capsuleBlend<0)capsuleBlend=0;if(capsuleBlend>1)capsuleBlend=1;
    capsuleBlend=capsuleBlend*capsuleBlend*(3-2*capsuleBlend);
    local capsuleOffset=(capsuleEye+Vector(34.75,33.0,-10)-capsuleRest)*capsuleBlend;
    local fracture=Entities.FindByName(null,"intro_pod_crack");
    if(fracture!=null){
        if(t<120.75)fracture.SetOrigin(Vector(0,0,-3000));
        else{
            local f=(t-121.0873914)/(121.1541246-121.0873914);if(f<0)f=0;if(f>1)f=1;f=f*f*(3-2*f);
            local g=1-f;
            fracture.SetOrigin(Vector(11420,23.6,147.6)+Vector(-15.000000,-6.993359,-0.122535)*g+capsuleOffset);
            fracture.__KeyValueFromString("angles",(16.652917*g)+" "+(15.193000*g)+" "+(11.087844*g));
        }
    }
    Hide("intro_pod_shatter",false,rest);
    Hide("intro_pod_shade",false,rest);
    Hide("intro_end_flash",false,rest);
    local dim=(t>=120.75 && t<123.2);
    if(dim!=podDim){podDim=dim; local c=dim?"112 116 120":"255 255 255"; EntFire("intro_pod_body","Color",c,0); EntFire("intro_pod","Color","255 255 255",0);}
    local pod=Vector(PODX,PODY,PODZ);
