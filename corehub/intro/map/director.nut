function SetPursuitShaft(t) {
    foreach(track in p9ShaftDebris){
        local e=Entities.FindByName(null,track.name);if(e==null)continue;
        local tab=track.poses;
        if(t<tab[0][0]||t>tab[tab.len()-1][0]){e.SetOrigin(Vector(0,0,-3000));continue;}
        local p=tab[0][1];
        for(local i=0;i<tab.len()-1;i++)if(t>=tab[i][0]&&t<=tab[i+1][0]){
            local f=(t-tab[i][0])/(tab[i+1][0]-tab[i][0]);p=tab[i][1]+(tab[i+1][1]-tab[i][1])*f;break;
        }
        e.SetOrigin(p);e.__KeyValueFromString("angles",(t*83)+" "+(t*57)+" "+(t*31));
    }
    for(local station=0;station<2;station++){
        local z=station==0?1648:1280;
        local f=(t-(station==0?110.88:111.33))/(station==0?0.17:0.20);
        if(f<0)f=0;if(f>1)f=1;
        local d=f*(station==0?41:80);
        for(local i=0;i<4;i++){
            local a=(i*90+45)*0.01745329252;
            local p=Vector(8448+cos(a)*d,sin(a)*d,z);
            if(t>111.75)p=Vector(0,0,-3000);
            MoveProp("intro_p9_shaft_iris_"+station+"_"+i,p);
        }
    }
    foreach(z in [1430,1324])for(local i=0;i<4;i++){
        local a=i*1.570796326795;local p=Vector(8448+58*cos(a),58*sin(a),z);
        MoveProp("intro_p9_scan_red_"+z+"_"+i,(t>=111.75&&t<113.8)?p:Vector(0,0,-3000));
    }
}

function SetIris(name,center,f) {
    if(f<0)f=0; if(f>1)f=1;
    // The exit petals slide in front of the surrounding panel, not into it.
    if(name=="intro_incinerator_iris")center=center+Vector(-12,0,0);
    for(local i=0;i<4;i++){
        local a=(i*90+45)*0.0174532925;
        local handed=(name=="intro_final_iris"?-1:1);
        local d=54*f;
        local offset=(name=="intro_iris"?Vector(-25*f*sin(a),25*f*cos(a),-68*f):Vector(0,handed*d*cos(a),d*sin(a)));
        MoveProp(name+"_"+i,center+offset);
    }
}
irisCeilingLit <- null;
function SetIntroIris(t) {
    // 22-22.75 s: the closed disc sits retracted in its trap door (z 262).
    // 22.75-23 s: it comes down flush with the ceiling (its face 1.5 below the
    // tiles, so the spreading petals slide over them as in the video), the
    // petals spread, and the frame settles at the top of the shaft (z 262).
    // 31-31.6 s: retract as the camera actually crosses into the tube.
    local d=(t-22.75)/0.25; if(d<0)d=0; if(d>1)d=1; d=d*d*(3-2*d);
    d=Lerp1([[22.5,0],[22.6,0.23],[22.65,0.3089482],[22.7,0.343596],[22.75,0.4085875],[22.8,0.4423864],[22.85,0.5135333],[22.9,0.5604078],[22.95,0.6125715],[23.0,0.6343375],[23.1,0.7102489],[23.2,0.7860345],[23.3,0.95118],[23.4,1.0]],t);
    local s=(t-22.9)/0.6; if(s<0)s=0; if(s>1)s=1; s=s*s*(3-2*s);
    local r=(t-31.0)/0.6; if(r<0)r=0; if(r>1)r=1; r=r*r*(3-2*r);
    local fz=(t<22.8)?420:(420-214.89262324*d)+214.89262324*r;
    MoveProp("intro_iris_frame",Vector(1.65015983,-256,fz));
    local lit=(t>=21.9 && t<32.5);
    if(lit!=irisCeilingLit){
        irisCeilingLit=lit;
        EntFire("intro_iris_ceiling_fill",lit?"TurnOn":"TurnOff","",0);
    }
    MoveProp("intro_iris_rings",Vector(1.65015983,0,16+fz-205.10737676));
    for(local i=0;i<4;i++){
        local a=(i*90+45)*0.0174532925;
        local k=Lerp1([[22.9, 0], [23.0, 4.0], [23.1, 12.0046], [23.2, 22.5336], [23.3, 33.3051], [23.4, 41.4304], [23.5, 46.3554], [23.6, 48.0918], [23.7, 48.1355], [23.8, 48.1355], [23.9, 48.1443], [24.0, 48.27]],t)+50*r;
        MoveProp("intro_iris_"+i,Vector(1.65015983,-256,253)+Vector(-k*sin(a),k*cos(a),-65.39262324*d*(1-r)+60*r));
    }
}
