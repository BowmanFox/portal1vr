cpHide <- ["intro_pod","intro_pod_body","intro_pod_crack","intro_pod_shell"];
cpRedEnts <- ["r11_cp_ceiling","r11_cp_frame","r11_cp_frameout","r11_cp_btube","r11_cp_shutter","r11_cp_lamp","r11_cp_petal0","r11_cp_petal1","r11_cp_petal2","r11_cp_petal3"];
cpRed <- [[125.180,Vector(180,105,105)],[126.000,Vector(185,115,110)],[126.500,Vector(215,170,160)],[127.000,Vector(245,230,225)],[127.300,Vector(255,255,255)]];
cpRedLast <- "";
function CP_Update(t) {
    if(t<119.200||t>132.400)return;
    foreach(nm in cpHide){local e=Entities.FindByName(null,nm); if(e!=null)e.SetOrigin(Vector(5100,9900,-2950));}
    foreach(tr in cpTracks){
        local e=Entities.FindByName(null,tr.name); if(e==null)continue;
        if(t<tr.on||t>tr.off){e.SetOrigin(Vector(5100,9900,-2950));continue;}
        local k=tr.k; local n=k.len(); local a=k[0]; local b=k[0]; local f=0.0;
        if(t<=k[0][0]){a=k[0];b=k[0];}
        else if(t>=k[n-1][0]){a=k[n-1];b=k[n-1];}
        else {for(local i=0;i<n-1;i++)if(t>=k[i][0]&&t<=k[i+1][0]){a=k[i];b=k[i+1];f=(t-a[0])/(b[0]-a[0]);break;}}
        e.SetOrigin(a[1]+(b[1]-a[1])*f);
        if(a[3]==1){local g=a[2]+(b[2]-a[2])*f;e.__KeyValueFromString("angles",g.x+" "+g.y+" "+g.z);}
    }
    SetScreenBlack(Lerp1(cpFade,t));
    local c=Vector(255,255,255);
    if(t>=cpRed[0][0]){c=cpRed[cpRed.len()-1][1];for(local i=0;i<cpRed.len()-1;i++)if(t>=cpRed[i][0]&&t<=cpRed[i+1][0]){local f=(t-cpRed[i][0])/(cpRed[i+1][0]-cpRed[i][0]);c=cpRed[i][1]+(cpRed[i+1][1]-cpRed[i][1])*f;break;}}
    local cs=(c.x.tointeger())+" "+(c.y.tointeger())+" "+(c.z.tointeger());
    if(cs!=cpRedLast){cpRedLast=cs;foreach(nm in cpRedEnts){local e=Entities.FindByName(null,nm); if(e!=null)e.__KeyValueFromString("rendercolor",cs);}}
}
cpFade <- [[119.2000,255.0],[119.3000,219.0],[119.5000,165.0],[119.7000,10.0],[119.7500,0.0],[131.2000,0.0],[131.3300,38.0],[131.6000,153.0],[131.8600,229.0],[132.1300,252.0],[132.4000,255.0]];
::FL_Cube1_tab <- [[99.9665,-8206.00,15700.00,0.00],[100.4003,-7684.00,15700.00,0.00],[100.7006,-7323.00,15700.00,0.00],[101.0009,-7008.00,15700.00,0.00],[101.3012,-6691.00,15700.00,0.00],[101.6015,-6372.00,15700.00,0.00],[101.6682,-6372.00,15700.00,-45.00],[101.7350,-6372.00,15700.00,-150.00],[101.8017,-6372.00,15700.00,-300.00]];
function FL_Cube1(t) {
    local tab = ::FL_Cube1_tab; local n = tab.len();
    if (t < tab[0][0] || t > tab[n - 1][0]) { MoveProp("r11_fl_cube1", Vector(tab[0][1], tab[0][2], tab[0][3] - 2600)); return; }
    local i = 0;
    while (i < n - 2 && t >= tab[i + 1][0]) i++;
    local f = (t - tab[i][0]) / (tab[i + 1][0] - tab[i][0]);
    MoveProp("r11_fl_cube1", Vector(tab[i][1] + (tab[i + 1][1] - tab[i][1]) * f, tab[i][2] + (tab[i + 1][2] - tab[i][2]) * f, tab[i][3] + (tab[i + 1][3] - tab[i][3]) * f));
}
::FL_fade_tab <- [[96.5500,0.0],[99.6078,0.0],[99.6412,85.8],[99.6746,157.5],[99.7079,208.6],[99.7413,238.4],[99.7747,253.5],[99.8080,255.0],[99.9415,255.0],[99.9749,250.5],[100.0082,204.3],[100.0416,67.3],[100.0750,0.0],[104.9799,0.0],[105.0132,62.5],[105.0466,123.5],[105.0800,178.1],[105.1133,213.1],[105.1467,235.6],[105.1801,251.4],[105.2134,253.6],[105.2468,254.4],[105.2802,255.0],[105.3135,255.0],[105.6472,255.0],[105.6806,226.4],[105.7139,172.1],[105.7473,76.7],[105.7807,27.2],[105.8140,0.0],[109.5511,0.0],[109.5845,131.2],[109.6178,224.7],[109.6512,254.5],[109.6846,255.0],[109.9000,255.0]];
function FL_Fade(t) {
    local tab = ::FL_fade_tab; local n = tab.len();
    if (t < tab[0][0] || t > tab[n - 1][0]) return;
    local i = 0;
    while (i < n - 2 && t >= tab[i + 1][0]) i++;
    local f = (t - tab[i][0]) / (tab[i + 1][0] - tab[i][0]);
    SetScreenBlack(tab[i][1] + (tab[i + 1][1] - tab[i][1]) * f);
}
