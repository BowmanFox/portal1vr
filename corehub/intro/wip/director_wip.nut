r11CubeKeys <- [[30.5305,-12906.39,-48.04,181.89,0.1,90.1,-0.1],[30.5639,-12900.15,-44.10,218.88,5.4,97.1,-8.8],[30.5972,-12900.46,-44.91,254.89,10.2,104.1,-17.5],[30.6306,-12902.69,-40.10,307.81,14.2,111.1,-26.2],[30.6640,-12906.53,-36.50,369.89,16.8,118.1,-34.8],[30.6973,-12907.22,-35.62,434.33,18.0,125.1,-43.5],[30.7307,-12915.39,-39.00,517.23,17.5,132.1,-52.2],[30.7641,-12918.17,-37.37,615.97,15.5,139.2,-60.9],[30.7974,-12920.59,-40.11,687.51,12.1,146.2,-69.5],[30.8308,-12909.09,-38.81,753.38,7.6,153.2,-78.2],[31.0980,-12894.98,-47.12,1230.00,-16.6,209.3,-147.7],[31.3980,-12894.98,-47.12,1750.00,18.0,272.3,-225.7],[32.0000,-12894.98,-47.12,3008.00,11.1,398.7,-382.2],[32.1500,-12894.98,-47.12,3150.00,16.3,430.2,-421.2]];
function P41_SetEarlyShaftCube(t) {
    local e=Entities.FindByName(null,"p41_intro_early_cube");if(e==null)return;
    local n=r11CubeKeys.len();
    if(t<r11CubeKeys[0][0] || t>=r11CubeKeys[n-1][0]){e.SetOrigin(Vector(-13056.3,-47.1,-1757.1));return;}
    e.__KeyValueFromString("rendercolor","255 255 255");
    for(local i=0;i<n-1;i++){
        local a=r11CubeKeys[i],b=r11CubeKeys[i+1];if(t>b[0])continue;
        local f=(t-a[0])/(b[0]-a[0]);if(f<0)f=0;
        e.SetOrigin(Vector(a[1]+(b[1]-a[1])*f,a[2]+(b[2]-a[2])*f,a[3]+(b[3]-a[3])*f));
        e.__KeyValueFromString("angles",(a[4]+(b[4]-a[4])*f)+" "+(a[5]+(b[5]-a[5])*f)+" "+(a[6]+(b[6]-a[6])*f));
        return;
    }
}
function P41_MoveEarly(name,p){local e=Entities.FindByName(null,name);if(e!=null){local q=Vector(162.2,-132.3,127.3)+(p-Vector(162.2,-132.3,127.3))*1.5170630816959667;if(name=="p41_intro_ceiling_wire")q+=Vector(57.48747547,-54.12638387,-9.24376903);if(name=="p41_intro_ceiling_chip_0")q+=Vector(38.25808012,-42.56427126,-0.01468459);if(name=="p41_intro_ceiling_chip_1")q+=Vector(38.74625753,-31.00226695,-0.04881075);if(name=="p41_intro_ceiling_chip_2")q+=Vector(35.45759532,-31.10250649,-0.04881075);if(q.z<4)q.z=4;e.SetOrigin((q)+Vector(-13000,0,0));}}
function P41_SetOpeningDebris(t) {
    local starts=[Vector(127.864,-160.735,219),Vector(162.494,-91.175,221),Vector(149.355,-91.488,221)];
    local velocities=[300.0,180.0,110.0];
    local gravities=[1400.0,700.0,500.0];
    local restZ=[3.124,1.7329,1.957];
    local elapsed=t-6.8;if(elapsed<0)elapsed=0;
    for(local i=0;i<3;i++) {
        local fall=velocities[i]*elapsed+0.5*gravities[i]*elapsed*elapsed;
        if(fall>starts[i].z-restZ[i])fall=starts[i].z-restZ[i];
        P41_MoveEarly("p41_intro_ceiling_chip_"+i,starts[i]-Vector(0,0,fall));
    }
    local f=(t-6.8)/0.35;if(f<0)f=0;if(f>1)f=1;
    f=f*f*(3-2*f);
    P41_MoveEarly("p41_intro_ceiling_wire",Vector(154.862409,-142.150324,174.327556-(174.327556-1.658499)*f));
    local wire=Entities.FindByName(null,"p41_intro_ceiling_wire");
    if(wire!=null)wire.__KeyValueFromString("angles","0 0 "+(90*f));
}


P41_lastExposure <- -1;
function P41_Update(t){
 if(t>=32.51)return;
 P41_SetIntroIris(t);P41_SetEarlyShaftCube(t);P41_SetOpeningDebris(t);
 local exposure=P41_Lerp1([[0,0.93],[9.6,0.93],[10.0,0.72],[10.3,0.56],[10.5,0.42],[10.6,0.30],[10.75,0.20],[10.9,0.08],[11.1,0.06],[11.6,0.10],[12.4,0.75],[21.2,0.75],[21.7,0.35],[22.05,0.35],[22.35,0.93],[33,0.93]],t);
 if(exposure!=P41_lastExposure){P41_lastExposure=exposure;
  EntFire("p41_preview_ceiling_control","SetMaterialVar","["+exposure+" "+(exposure*0.976)+" "+(exposure*1.01)+"]",0);
 }
 local cover=(t-21.68601551)/1.38905147;if(cover<0)cover=0;if(cover>1)cover=1;
 P41_MoveProp("p41_intro_iris_cover",Vector(0,210*cover,16));
}

function SetSceneTime(t) {
    P41_Update(t);
    local originalTime=t;
    if(t<0)t=0; if(t>134)t=134;
    ApplyFov(t);
    local cut=false;
    foreach(c in cutTab) if(t>=c[0] && t<c[1]) cut=true;
    local fadeAlpha=cut?255:0;
    if(t<5.338656)fadeAlpha=Lerp1(openingReveal,t).tointeger();
    // Source tube highlight rises steadily105.6387–106.5729 after the lab cut.
    if(t>=105.6386556 && t<106.5729204)fadeAlpha=Lerp1([
        [105.6386556,254.0],[105.6720222,227.0],[105.7053888,215.0],
        [105.7387554,207.0],[105.8054886,192.0],[105.9055884,170.0],
        [106.0056882,146.0],[106.1057880,121.0],[106.2058878,92.0],
        [106.3059876,65.0],[106.4060874,45.0],[106.5061872,21.0],
        [106.5729204,0.0]],t);
    if(t>=118.3847 && t<120.0)fadeAlpha=Lerp1([[118.3847,255.0],
        [119.2189,255.0],[119.2522,225.0],[119.2856,172.0],
        [119.3523,152.0],[119.4858,125.0],[119.6193,97.0],
        [119.7527,67.0],[120.0,0.0]],t);
    // Preserve the source ending fade, then restore the stationary free-look
    // endpoint after the film's134-second duration.
    if(originalTime>=131.2308376)fadeAlpha=Lerp1(closingFade,originalTime);
    if(t<32.4990684){
      if(t<6.85)fadeAlpha=92;
      if(t<5.338656)fadeAlpha=92+(255-92)*Lerp1(openingReveal,t)/255;
      if(t>=32.1654024)fadeAlpha=Lerp1([[32.1654024,0],[32.2321356,32],[32.2655022,61],[32.2988688,94],[32.3322354,122],[32.365602,155],[32.3989686,187],[32.4323352,215],[32.4657018,244],[32.4990684,255]],t);
    }
    if(t>=96.596307 && t<96.7297734)
      fadeAlpha=Lerp1([[96.596307,238],[96.6630402,120],[96.7297734,0]],t);
    if(t>=99.599301 && t<99.7995006)
      fadeAlpha=Lerp1([[99.599301,0],[99.6660342,96],[99.7327674,184],[99.7995006,255]],t);
    foreach(f in r10Fades) if(t>=f[0] && t<f[1]){local k=(t-f[0])/(f[1]-f[0]);local a=(f[2]+(f[3]-f[2])*k).tointeger();if(a>fadeAlpha)fadeAlpha=a;}
