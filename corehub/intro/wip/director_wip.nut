PODX <- 11491.50; PODY <- 28.0; PODZ <- 131.0; XHW <- 11296.0;
function Lerp1(tab,t) {
    if(t<=tab[0][0])return tab[0][1];
    for(local i=0;i<tab.len()-1;i++){
        if(t<tab[i+1][0]){local a=tab[i],b=tab[i+1];return a[1]+(b[1]-a[1])*(t-a[0])/(b[0]-a[0]);}
    }
    return tab[tab.len()-1][1];
}
// Vault shutter (carries the lamp): z offset from its closed rest position.
shutterTab <- [[126.8,-200.0],[127.0,-170.0],[127.25,-135.0],[127.5,-113.83654],[127.75,-89.80518],[128,-66.39047],[128.25,-41.23837],[128.5,-15.9],[128.75,-9.5],[129.0,-6.1],[129.5,-2.4],[130.0,0.0],[130.5,-0.6],[131.0,-2.4]];
// Hatch petals: diagonal opening per axis.
petalTab <- [[119.78,0.0],[120.01,52.0],[123.4,52.0],[124.0,30.0],[124.5,23.0],[125.0,14.0],[125.5,5.0],[125.8,0.0]];
podDim <- null;
function Hide(name,show,rest) { MoveProp(name,show?rest:Vector(0,0,-3000)); }
function SetEnding(t) {
    local rest=Vector(0,0,16);
    local g=Lerp1(petalTab,t);
    local bright=(t>=125.2);
    for(local i=0;i<4;i++){
        local su=(i==0||i==3)?1:-1; local sv=(i<2)?1:-1;
        local off=Vector(0,su*g,16+sv*g);
        MoveProp("intro_final_petal_"+i,bright?Vector(0,0,-3000):off);
        MoveProp("intro_final_petalb_"+i,bright?off:Vector(0,0,-3000));
    }
    MoveProp("intro_final_shutter",Vector(0,0,16+Lerp1(shutterTab,t)));
    Hide("intro_final_redmod",t>=125.2 && t<126.35,rest);
    // The cover and fracture share the body's delivery motion. Leaving them
    // at their old world position made the later camera pass through the pane.
    local capsuleRest=Vector(PODX,PODY,PODZ);
    local capsuleEye=PositionAt(t);
    local capsuleBlend=(t-124.6)/0.8;if(capsuleBlend<0)capsuleBlend=0;if(capsuleBlend>1)capsuleBlend=1;
    capsuleBlend=capsuleBlend*capsuleBlend*(3-2*capsuleBlend);
    local capsuleOffset=(capsuleEye+Vector(34.75,33.0,-10)-capsuleRest)*capsuleBlend;
    local fracture=Entities.FindByName(null,"intro_pod_crack");
    if(fracture!=null){
        if(t<120.75)fracture.SetOrigin(Vector(0,0,-3000));
        else{
            local f=(t-121.0873914)/(121.1541246-121.0873914);if(f<0)f=0;if(f>1)f=1;f=f*f*(3-2*f);
            local g=1-f;
            fracture.SetOrigin(Vector(11420,23.6,147.6)+Vector(-15.000000,-6.993359,-0.122535)*g+capsuleOffset);
            fracture.__KeyValueFromString("angles",(16.652917*g)+" "+(15.193000*g)+" "+(11.087844*g));
        }
    }
    Hide("intro_pod_shatter",false,rest);
    Hide("intro_pod_shade",false,rest);
    Hide("intro_end_flash",false,rest);
    local dim=(t>=120.75 && t<123.2);
    if(dim!=podDim){podDim=dim; local c=dim?"112 116 120":"255 255 255"; EntFire("intro_pod_body","Color",c,0); EntFire("intro_pod","Color","255 255 255",0);}
    local pod=Vector(PODX,PODY,PODZ);
    MoveProp("intro_pod",pod+capsuleOffset);
    local eye=PositionAt(t);
    local b=(t-124.6)/0.8; if(b<0)b=0; if(b>1)b=1; b=b*b*(3-2*b);
    local follow=eye+Vector(34.75,33.0,-10);
    MoveProp("intro_pod_body",pod+(follow-pod)*b);
    MoveProp("intro_pod_shell",(t>=125.3)?Vector(0,Lerp1(r10ShellSlide,t),16)+eye-Vector(XHW+160,0,134):Vector(0,0,-3000));
    local radio=Entities.FindByName(null,"intro_delivery_radio");
    if(radio!=null){
        if(t<124.55 || t>125.8)radio.SetOrigin(Vector(PODX,0,-2600));
        else{
            local keys=[
    {t=124.55000,p=Vector(10617.22676,24.91338,103.39404),a=Vector(4,-44,37)},
    {t=124.75000,p=Vector(11025.96049,-6.21604,108.07476),a=Vector(4,-38,40)},
    {t=125.00000,p=Vector(11285.81675,11.57472,111.85833),a=Vector(4,-31,43)},
    {t=125.10000,p=Vector(11369.71829,18.75351,113.5065),a=Vector(4,-25,40)},
    {t=125.15000,p=Vector(11397.82825,21.38072,113.43348),a=Vector(3,-18,34)},
    {t=125.25000,p=Vector(11383.62761,20.95145,116.82675),a=Vector(-45,-25,60)},
    {t=125.35000,p=Vector(11336.15893,-0.11387,117.13656),a=Vector(-30,-20,83)},
    {t=125.45000,p=Vector(11344.71265,3.56164,116.3775),a=Vector(-12,-10,95)},
    {t=125.60000,p=Vector(11325.61608,-14.70446,116.77634),a=Vector(35,5,108)},
    {t=125.80000,p=Vector(11340.0,-60.0,116.0),a=Vector(70,10,120)}
            ];
            local k=0;while(k<keys.len()-2 && t>keys[k+1].t)k++;
            local f=(t-keys[k].t)/(keys[k+1].t-keys[k].t);if(f<0)f=0;if(f>1)f=1;
            local p=keys[k].p+(keys[k+1].p-keys[k].p)*f;
            local a=keys[k].a+(keys[k+1].a-keys[k].a)*f;
            radio.SetOrigin(p);radio.__KeyValueFromString("angles",a.x+" "+a.y+" "+a.z);
        }
    }
}
// Reference-derived sweep: right/down/right/up, then toward the observer.
// Endpoint motion is in world space and leaves the existing camera untouched.
turretLaserKeys <- [
 {t=67.2,p=Vector(4646,-3,1130)},
 {t=67.5,p=Vector(4646,-3,1130)},
 {t=67.75,p=Vector(4605,15,1085)},
 {t=68.0,p=Vector(4562,52,1069)},
 {t=68.25,p=Vector(4612,26,1085)},
 {t=68.5,p=Vector(4661,11,1129)},
 {t=69.0,p=Vector(4667,13,1179)},
 {t=69.3,p=Vector(4667,13,1179)},
 {t=69.5,p=Vector(4667,13,1179)},
 {t=70.0,p=Vector(4667,13,1179)},
 {t=71.35,p=Vector(4667,13,1179)}
];
shaftBeamState <- -1;
turretBeamState <- -1;
function SetTransportBeams(t) {
    local n=0;
    while(n<turretLaserKeys.len()-2 && t>=turretLaserKeys[n+1].t)n++;
    local a=turretLaserKeys[n],b=turretLaserKeys[n+1];
    local f=(t-a.t)/(b.t-a.t);if(f<0)f=0;if(f>1)f=1;
    // This2009 runtime interprets SetOrigin on a child in parent-local space.
    // The keyed aim points remain in world space; inverse-transform by the
    // static turret parent at(4575,58,1159), yaw-114.
    local worldEnd=a.p+(b.p-a.p)*f;
    local rel=worldEnd-Vector(4575,58,1159);
    local localEnd=Vector(-0.4067366431*rel.x-0.9135454576*rel.y,
                          0.9135454576*rel.x-0.4067366431*rel.y,rel.z);
    MoveProp("laser_turret_b",localEnd);
    local turretOn=(t>=67.2 && t<69.4)?1:0;
    if(turretOn!=turretBeamState) {
        EntFire("laser_turret",turretOn==1?"TurnOn":"TurnOff","",0);
        turretBeamState=turretOn;
    }
    // Exact79.5 still has red projection; by80.0 it has cleared the yellow scan.
    // Names are supplied by the shared scanner_arms beam-naming correction.
    local shaftOn=(t>=72.25 && t<79.6)?1:0;
    if(shaftOn!=shaftBeamState) {
        foreach(z in [1200,760,620])for(local i=0;i<3;i++)
            EntFire("shaft_"+z+"_"+i+"_beam",shaftOn==1?"TurnOn":"TurnOff","",0);
        shaftBeamState=shaftOn;
    }
}
function SetTransferScanners(t) {
    local n=0;
    while(n<transferScanPoses.len()-2 && t>=transferScanPoses[n+1].t)n++;
    local a=transferScanPoses[n],b=transferScanPoses[n+1];
    local f=(t-a.t)/(b.t-a.t);if(f<0)f=0;if(f>1)f=1;
    local labels=["upper","fore","head"];
    for(local i=0;i<6;i++) {
        local pa=a.parts[i],pb=b.parts[i];
        local pos=pa.p+(pb.p-pa.p)*f,angle=pa.a+(pb.a-pa.a)*f;
        local arm=i/3,part=i%3;
        local e=Entities.FindByName(null,"intro_transfer_scan_"+labels[part]+"_"+arm);
        if(e!=null){e.SetOrigin(pos);e.__KeyValueFromString("angles",angle.x+" "+angle.y+" "+angle.z);}
        if(part==2) {
            local cone=Entities.FindByName(null,"intro_transfer_scan_cone_"+arm);
            local visible=(arm==0)?(t>=78.4 && t<80.2):(t>=80.15 && t<82.45);
            if(cone!=null){cone.SetOrigin(visible?pos:Vector(0,0,-3000));cone.__KeyValueFromString("angles",angle.x+" "+angle.y+" "+angle.z);}
        }
    }
}
function SetFinalScanners(t) {
    local n=0;
    while(n<finalScanPoses.len()-2 && t>=finalScanPoses[n+1].t)n++;
    local a=finalScanPoses[n],b=finalScanPoses[n+1];
    local f=(t-a.t)/(b.t-a.t);if(f<0)f=0;if(f>1)f=1;
    local labels=["upper","fore","head"];
    for(local i=0;i<9;i++){
        local pa=a.parts[i],pb=b.parts[i];
        local pos=pa.p+(pb.p-pa.p)*f,angle=pa.a+(pb.a-pa.a)*f;
        local arm=i/3,part=i%3;
        local e=Entities.FindByName(null,"intro_final_scan_"+labels[part]+"_"+arm);
        if(e!=null){e.SetOrigin(pos);e.__KeyValueFromString("angles",angle.x+" "+angle.y+" "+angle.z);}
        if(part==0)MoveProp("intro_final_scan_mount_"+arm,pos);
        if(part==2){
            local cone=Entities.FindByName(null,"intro_final_scan_cone_"+arm);
            if(cone!=null){cone.SetOrigin((t>=116.65&&t<117.42)?pos:Vector(0,0,-3000));cone.__KeyValueFromString("angles",angle.x+" "+angle.y+" "+angle.z);}
            local longcone=Entities.FindByName(null,"intro_final_scan_long_cone_"+arm);
            if(longcone!=null){longcone.SetOrigin((t>=115.32&&t<116.65)?pos:Vector(0,0,-3000));longcone.__KeyValueFromString("angles",angle.x+" "+angle.y+" "+angle.z);}
        }
    }
}
function ReferenceAngles(t) {
    local ov=CamOvFind(t); if(ov!=null)return CamOvValue(ov,t,4);
    if(t<21.7)return Wake46At(t,true);
    if(t>=96.596307 && t<99.7995006)return Factory43At(t,true);

    local i=0;
    while(i<knots.len()-2 && t>=knots[i+1].t)i++;
    local a=knots[i],b=knots[i+1],f=(t-a.t)/(b.t-a.t);
    if(f<0)f=0;if(f>1)f=1;
    return a.a+(b.a-a.a)*f;
}
function AddReferencePan(t) {
 if(eyeSample==null || viewCamera==null)return;
 local reference=ReferenceAngles(t),observed=MeasuredLook();local desired=reference+observed;
 if(rideTakeover){
  local f=EaseWalk((t-21.7)/1.6);
  local input=Vector(WrapDelta(observed.x-rideInputBase.x),WrapDelta(observed.y-rideInputBase.y),0);
  local delta=Vector(WrapDelta(reference.x-rideLookBase.x),WrapDelta(reference.y-rideLookBase.y),reference.z);
  desired=rideLookBase+delta*f+input;
 }
 if(desired.x>180)desired.x=180;if(desired.x< -180)desired.x=-180;
 viewCamera.__KeyValueFromString("angles",desired.x+" "+desired.y+" "+desired.z);
}
function Tick() {
 if(!started || player==null)return;
 local t=Time()-startTime;local bounded=t>134?134:t;local p=player.GetOrigin()+Vector(0,0,64);
 if(openingWalking && t>=21.7)BeginSuction(t);
 if(!openingWalking){
  AddReferencePan(bounded);p=PositionAt(bounded);
  if(rideTakeover && t<23.3)p=pullStartEye+(p-pullStartEye)*EaseWalk((t-21.7)/1.6);
  if(viewCamera!=null)viewCamera.SetOrigin(p);
  player.SetOrigin(p-Vector(0,0,64));player.SetVelocity(Vector(0,0,0));
 }
 SetSceneTime(t);
 Op_Update(t);
 Ru_Fade(t);
 Tw_Update(t);
 Tw_Fade(t);
 Tu_Update(t);
 Sc_ShotA(t);
 Sc_Cube(t);
 Sc_Head(t);
 Sc_Fade(t);
 SgFade(t);
 SgRing(t);
 IC_Update(t);
 CP_Update(t);
 FL_Cube1(t);
 FL_Fade(t);
 R11PC_Cube(t);
 R11PC_Show(t);
 local report=t.tointeger()/10;
 if(!finished && report!=lastReport){lastReport=report;printl("COREHUB_INTRO T="+t+" POSITION="+p+" walking="+openingWalking);}
 if(t>=134 && !finished){finished=true;printl("COREHUB_INTRO COMPLETE duration="+t);}
 EntFire("intro_director","CallScriptFunction","Tick",0.015);
}
opHousingTint <- -1;
function Op_Update(t) {
    if(t>=32.5)return;
    if(t>=7.2){local w=Entities.FindByName(null,"p41_intro_ceiling_wire");if(w!=null)w.SetOrigin(Vector(-12791.4,-201.4,-3000));}
    // the ceiling housing darkens with the ceiling's exposure (same curve as P41_Update)
    local ex=P41_Lerp1([[0,0.93],[9.6,0.93],[10.0,0.72],[10.3,0.56],[10.5,0.42],[10.6,0.30],[10.75,0.20],[10.9,0.08],[11.1,0.06],[11.6,0.10],[12.4,0.75],[21.2,0.75],[21.7,0.35],[22.05,0.35],[22.35,0.93],[33,0.93]],t);
    local c=(255.0*ex/0.93).tointeger(); if(c>255)c=255; if(c<0)c=0;
    if(c!=opHousingTint){opHousingTint=c;local h=Entities.FindByName(null,"p41_preview_housing_mesh");if(h!=null)h.__KeyValueFromString("rendercolor",c+" "+c+" "+c);}
}
ruFadeIn <- [[32.6000,255.0],[32.6740,229.0],[32.7410,179.0],[32.8080,104.0],[32.8740,31.0],[32.9200,0.0],[33.1600,0.0]];
ruFadeOut <- [[38.3800,0.0],[38.4470,40.0],[38.5130,117.0],[38.5800,159.0],[38.6470,175.0],[38.7140,198.0],[38.7800,217.0],[38.8470,236.0],[38.9140,250.0],[38.9400,255.0]];
function Ru_Fade(t) {
    if(t>=32.6000 && t<33.1600) SetScreenBlack(Lerp1(ruFadeIn,t));
    if(t>=38.3800 && t<38.9400) SetScreenBlack(Lerp1(ruFadeOut,t));
}
