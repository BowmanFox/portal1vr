tuBlack <- [[63.9873,0.0],[74.0006,0.0]];
tuGrey <- [[63.9873,0.0],[69.4564,0.0],[69.4574,46.0],[69.4954,46.0],[69.4964,0.0],[74.0006,0.0]];
function Tu_Update(t) {
    if(t<63.9953||t>73.9986)return;
    foreach(tr in tuTracks){
        local e=Entities.FindByName(null,tr.name); if(e==null)continue;
        if(t<tr.on||t>tr.off){e.SetOrigin(Vector(14150.0,16150.0,-2900.0));continue;}
        local k=tr.k; local n=k.len(); local a=k[0]; local b=k[0]; local f=0.0;
        if(t>=k[n-1][0]){a=k[n-1];b=k[n-1];}
        else if(t>k[0][0]){for(local i=0;i<n-1;i++)if(t>=k[i][0]&&t<=k[i+1][0]){a=k[i];b=k[i+1];f=(t-a[0])/(b[0]-a[0]);break;}}
        e.SetOrigin(a[1]+(b[1]-a[1])*f);
        if(a[3]==1){local g=a[2]+(b[2]-a[2])*f;e.__KeyValueFromString("angles",g.x+" "+g.y+" "+g.z);}
    }
    SetScreenBlack(Lerp1(tuBlack,t));
    local ga=Lerp1(tuGrey,t).tointeger();
    if(ga!=r10RedAlpha){local fe=Entities.FindByName(null,"r10_red_fade");if(fe!=null){fe.__KeyValueFromString("renderamt",""+ga);EntFire("r10_red_fade","Fade","",0);r10RedAlpha=ga;}}
}
function Sc_ShotA(t) {
    if(t<73.9 || t>75.2) return;
    local hid=Vector(0,0,-3000);
    MoveProp("r11_sc_a_tube",(t<74.12)?Vector(-7000.00,4200.00,9000.00):hid);
    local c=(t>=74.12 && t<74.62);
    MoveProp("r11_sc_a_cake",(c&&t<74.45)?Vector(-6907.00,4227.08,9021.04):hid);
    MoveProp("r11_sc_a_cakering",(c&&t<74.45)?Vector(-6740.00,4275.71,8926.54):hid);
    MoveProp("r11_sc_a_petal",c?Vector(-6943.00,4198.09,8996.48):hid);
    MoveProp("r11_sc_a_arm0",(t>=74.42&&t<74.66)?Vector(-6890.00,4253.47,9052.28):hid);
    MoveProp("r11_sc_a_arm1",(t>=74.42&&t<74.66)?Vector(-6890.00,4249.89,8968.92):hid);
    MoveProp("r11_sc_a_dark",(t>=74.62)?Vector(-7000.00,4200.00,9000.00):hid);
}
scCube <- [[75.0833,-3028.41,6477.20,14626.12],[75.1834,-3031.15,6482.28,14590.55],[75.2502,-3036.01,6485.79,14560.52],[75.3503,-3044.37,6491.10,14513.23],[75.4837,-3071.37,6498.86,14417.12],[75.7507,-2964.00,6536.00,14261.95],[76.4180,-3000.00,6500.00,14074.11],[76.9519,-3000.00,6500.00,13927.89],[77.7527,-3000.00,6500.00,13684.75],[78.2532,-3000.00,6500.00,13428.39]];
function Sc_Cube(t) {
    if(t<74.9 || t>78.4) return;
    local e=Entities.FindByName(null,"r11_sc_c_cube"); if(e==null) return;
    if(t>=scCube[scCube.len()-1][0]){e.SetOrigin(Vector(0,0,-3000));return;}
    local i=0; while(i<scCube.len()-2 && t>=scCube[i+1][0]) i++;
    local a=scCube[i], b=scCube[i+1], f=(t-a[0])/(b[0]-a[0]); if(f<0)f=0;
    e.SetOrigin(Vector(a[1]+(b[1]-a[1])*f, a[2]+(b[2]-a[2])*f, a[3]+(b[3]-a[3])*f));
    local n=t*29.97002997-2255.0;
    e.__KeyValueFromString("angles",(18+1.1*n)+" "+(35+2.2*n)+" "+(8+0.7*n));
}
scRed <- [Vector(-2980.68,6482.60,14062.00)];
scHeadZ <- [[78.9,-900.0],[79.75,-745.0],[80.25,-372.0],[80.53,-372.0],[81.2,-807.5]];
function Sc_Head(t) {
    if(t<74.0 || t>81.2) return;
    foreach(i,nm in ["r11_sc_c_red0"]) MoveProp(nm,(t>80.0)?Vector(0,0,-3000):scRed[i]);
    local f=(t-78.9)/1.1; if(f>1)f=1; if(f<0)f=0;
    local z=Lerp1(scHeadZ,t);
    local p=(t<78.9)?Vector(0,0,-3000):Vector(-2960.00+(-50.00)*f, 6540.00+(-40.00)*f, 14200.00+z);
    foreach(nm in ["r11_sc_c_head","r11_sc_c_cones"]) MoveProp(nm,p);
    MoveProp("r11_sc_c_arm",(t<78.9)?Vector(0,0,-3000):p+Vector(0,0,-30));
    MoveProp("r11_sc_c_arm2",(t<78.9)?Vector(0,0,-3000):p+Vector(0,0,-30));
    MoveProp("r11_sc_c_ring",(t>80.62)?Vector(0,0,-3000):Vector(-3000.00,6500.00,13740.00));
}
scFade <- [[73.9000,0.0],[74.6200,0.0],[74.7500,80.0],[74.9000,120.0],[75.0400,170.0],[75.0600,120.0],[75.1500,60.0],[75.2500,0.0],[82.8200,0.0],[82.9200,150.0],[83.0200,200.0],[83.1000,235.0],[83.1500,255.0],[83.2000,255.0]];
function Sc_Fade(t) {
    if(t>=73.95 && t<83.2) SetScreenBlack(Lerp1(scFade,t));
}
SgFadeIn <- [[84.50,255],[84.585,254],[84.651,249],[84.718,217],[84.785,184],[84.851,166],[84.918,59],[84.951,28],[84.99,0]];
